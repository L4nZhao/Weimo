DATABASE_URL="file:./dev.db"
PORT=3000
PUBLIC_BASE_URL="http://localhost:3000"
ADMIN_ALLOWED_ORIGINS="http://localhost:3000"
WECHAT_BIND_BASE_URL="http://localhost:3000"
# 存储根目录；留空时默认使用项目目录下的 storage/。
STORAGE_ROOT=""
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
ADMIN_COOKIE_SECURE=""
SESSION_SECRET="replace-with-a-long-random-string"
FILE_ACCESS_SECRET="replace-with-another-long-random-string"
SIGNED_FILE_URL_TTL_SECONDS=600
WEBHOOK_SECRET="replace-with-a-webhook-shared-secret"
REQUIRE_WEBHOOK_SIGNATURE="false"
# 微信 iLink 开放平台参数（从你的 iLink 接入方获取）
ILINK_BASE_URL=""
ILINK_CDN_BASE=""
ILINK_CHANNEL_VERSION=""
ILINK_API_KEY=""
ILINK_AUTO_POLL="true"
ILINK_POLL_RETRY_MS=5000
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL=""
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_MODEL=""
LLM_VISION_MODEL="qwen-vl-plus"
ROUTER_MODEL=""
ASR_MODEL="whisper-1"
IMAGE_RECOGNITION_API_KEY=""
IMAGE_RECOGNITION_BASE_URL=""
IMAGE_RECOGNITION_MODEL="qwen-vl-plus"
DASHSCOPE_API_KEY=""
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1" # example
DASHSCOPE_EMBEDDING_MODEL="text-embedding-v4"
MEMORY_AUTO_SAVE_MIN_LENGTH=4
AGENT_MAX_TURNS=6
# Optional: enables web-search skill via Tavily.
TAVILY_API_KEY=""

# 语音转写（可选）：填入支持 /audio/transcriptions (Whisper) 的服务端点后自动启用语音指令
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_API_KEY=sk-xxx（不填则复用 LLM_API_KEY）
# ASR_MODEL=whisper-1
